rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin users (managed manually in Firestore)
    match /admins/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Rate-limiting stats: each user can only read/write their own doc
    match /userStats/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /reports/{reportId} {
      // Anyone can read the community feed
      allow read: if true;

      // Authenticated users can submit reports
      allow create: if request.auth != null
                    && request.resource.data.title is string
                    && request.resource.data.title.size() < 200
                    && request.resource.data.description is string
                    && request.resource.data.description.size() < 2000
                    && request.resource.data.lat is number
                    && request.resource.data.lng is number
                    && request.resource.data.authorUid == request.auth.uid;

      // Authenticated users can vote (+1 or -1) OR flag (+1), OR admins can edit anything
      allow update: if request.auth != null
                    && (
                      // Vote: only the votes field changes by exactly ±1
                      (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
                        && (request.resource.data.votes - resource.data.votes == 1
                            || request.resource.data.votes - resource.data.votes == -1)
                      )
                      // Flag: only the flagCount field changes by exactly +1
                      || (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['flagCount'])
                        && request.resource.data.flagCount - resource.data.flagCount == 1
                      )
                      // Admin: can update anything
                      || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
                    );

      // Author or admin can delete
      allow delete: if request.auth != null
                    && (resource.data.authorUid == request.auth.uid
                        || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
  }
}
